# 依赖与运行数据（绝不进仓库）
node_modules/
/data/
/backups/
config.local.json
*.log
*.pid
.DS_Store

# 手改文件前留的备份（*.bak、*.bak-before-xxx、*.bak-20261022-0542 都算）
# 里面常常带着本机路径和号，自己留着看可以，别提交。
*.bak
*.bak-*

# 用户把 SnowLuma 放这儿时，别把第三方的几十 MB 一起提交
/vendor/

# 临时目录：只保留占位文件。
# 必须写成 /tmp/* 而不是 /tmp/ —— git 不会把"被排除目录"里的文件再拉回来，
# 用 /tmp/ 的话下面那条 !/tmp/.gitkeep 是无效的。
/tmp/*
!/tmp/.gitkeep

# 小本本是她自己的私房话，只把空架子和说明放进仓库
notebook/notes/*
notebook/memories/*
notebook/archive/*
notebook/tmp/*
!notebook/*/.gitkeep

# 产物：她画的图、别人发的表情原图
/SD-Picture/
/stickers/

# dsh-image-gen 插件把出图直接写在工作区根上，一个目录一张、两三 MB
/dsh-image-gen/

# SD 画图插件自己写进工作区的脚本，不是本项目的东西
sd-direct.ps1
sd-inject.ps1
sd-auto-mask.py

# 人设（persona/*.md）故意不挡：仓库里带一份能直接用的默认人设，
# self.md 是空的，留给她自己写。

# 踩坑便签：装好之后自己和 bot 边跑边攒的，不进仓库（_模板.md 留着）
procedures/_inbox.md

# 踩坑卡片：写的是某台机器上的具体现象，不进仓库（模板留着）
procedures/*.md
!procedures/_模板.md
